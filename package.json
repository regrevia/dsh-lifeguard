{
  "name": "dsh-lifeguard",
  "version": "0.7.2",
  "description": "把 DSH 真实崩溃日志沉淀成精简约束：装插件前静态预检拦崩、装完体检冲突，起不来时受控自愈",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./core": "./core.mjs",
    "./guard": "./guard.mjs",
    "./cli": "./cli.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./defense": "./defense.mjs",
    "./state": "./state.mjs",
    "./lib/*": "./lib/*.mjs",
    "./watchdog": "./watchdog.mjs",
    "./client": "./client.js"
  },
  "bin": {
    "lifeguard": "./cli.mjs"
  },
  "files": [
    "index.js",
    "handoff.mjs",
    "core.mjs",
    "guard.mjs",
    "defense.mjs",
    "cli.mjs",
    "memory.mjs",
    "doctor.mjs",
    "state.mjs",
    "pressure.mjs",
    "watchdog.mjs",
    "tmp.mjs",
    "client.js",
    "lib/*.mjs",
    "rules.seed.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "install-check/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-lifeguard.git"
  },
  "homepage": "https://github.com/regrevia/dsh-lifeguard",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-lifeguard/issues"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "crash",
    "preflight",
    "doctor"
  ],
  "author": {
    "name": "regrevia"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node cli.mjs check .",
    "verify": "npm test && npm run check",
    "test:host-resolve": "node scripts/real-host-resolve.mjs"
  }
}
